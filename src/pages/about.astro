---
import Layout from '../layouts/Layout.astro';

const description =
  'This Week South Bay is a free Monday 7am email and daily events board for Hermosa, Manhattan Beach, Redondo, El Segundo, and Torrance. Nights out, not news.';
---

<Layout
  title="About This Week South Bay | Free Monday Events Email"
  description={description}
  current="about"
  canonicalPath="/about"
>
  <article class="spare">
    <h1>About This Week South Bay</h1>
    <p>
      Residents of Hermosa, Manhattan, Redondo, El Segundo, Torrance. Palos Verdes
      only if it is worth the drive.
    </p>
    <p>Not news. Not tourism. Not city council, crime, real estate, or restaurant reviews.</p>
    <p>Monday email. 7am. Nights out, not news. Updated daily.</p>
    <p>
      <a href="https://thisweeksouthbay.beehiiv.com">thisweeksouthbay.beehiiv.com</a>
    </p>
  </article>
</Layout>
