{"target": "production", "name": "southbay-week", "teamId": "team_gy8cIX3w2ETSfkAwgQBJqVSi", "projectSettings": {"framework": "astro"}, "files": [{"file": "README.md", "data": "Static Astro site for This Week South Bay — a Monday list of nights out in Hermosa, Manhattan, Redondo, El Segundo, and Torrance. Events live in `src/data/events.json` as a snapshot until Airtable is wired. `npm install && npm run dev` (port 43177). `npm run build` writes the static site.\n"}, {"file": "astro.config.mjs", "data": "// @ts-check\nimport { defineConfig } from 'astro/config';\n\nexport default defineConfig({\n  output: 'static',\n});\n"}, {"file": "package.json", "data": "{\n  \"name\": \"this-week-south-bay\",\n  \"type\": \"module\",\n  \"version\": \"0.0.1\",\n  \"engines\": {\n    \"node\": \">=22.12.0\"\n  },\n  \"scripts\": {\n    \"dev\": \"astro dev --port 43177 --host\",\n    \"build\": \"astro build\",\n    \"preview\": \"astro preview --port 43177 --host\",\n    \"astro\": \"astro\"\n  },\n  \"dependencies\": {\n    \"@fontsource/public-sans\": \"^5.3.0\",\n    \"@vercel/analytics\": \"^1.6.1\",\n    \"astro\": \"^7.2.10\"\n  }\n}\n"}, {"file": "public/favicon.svg", "data": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\">\n  <rect width=\"32\" height=\"32\" fill=\"#faf7f0\"/>\n  <rect width=\"3\" height=\"32\" fill=\"#121212\"/>\n</svg>\n"}, {"file": "src/components/EmailCapture.astro", "data": "---\ninterface Props {\n  id: string;\n}\n\nconst { id } = Astro.props;\nconst fieldId = `${id}-email`;\n---\n\n<form id={id} class=\"email\" action=\"https://thisweeksouthbay.beehiiv.com\" method=\"get\">\n  <label class=\"visually-hidden\" for={fieldId}>Email</label>\n  <input id={fieldId} type=\"email\" name=\"email\" autocomplete=\"email\" placeholder=\"you@\" />\n  <a href=\"https://thisweeksouthbay.beehiiv.com\">Monday email. 7am.</a>\n</form>\n\n<style>\n  .visually-hidden {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n    border: 0;\n  }\n</style>\n"}, {"file": "src/components/EventRow.astro", "data": "---\nimport type { ListingEvent } from '../lib/events';\nimport { formatTimeRange } from '../lib/events';\n\ninterface Props {\n  event: ListingEvent;\n}\n\nconst { event } = Astro.props;\nconst time = formatTimeRange(event);\n---\n\n<li class=\"row\">\n  <time class=\"time\" datetime={event.start}>{time}</time>\n  <a class=\"title\" href={`/event/${event.slug}`}>{event.title}</a>\n  <span class=\"meta\">{event.venue}</span>\n  <span class=\"city\">{event.city}</span>\n  <span class=\"cost\">{event.cost}</span>\n</li>\n"}, {"file": "src/data/events.json", "encoding": "base64", "data": ""}, {"file": "src/layouts/Layout.astro", "data": "---\nimport '@fontsource/public-sans/400.css';\nimport '@fontsource/public-sans/700.css';\nimport '../styles/global.css';\nimport EmailCapture from '../components/EmailCapture.astro';\nimport Analytics from '@vercel/analytics/astro';\n\ninterface Props {\n  title: string;\n  description?: string;\n  current: 'week' | 'next' | 'last' | 'about' | 'event';\n}\n\nconst {\n  title,\n  description = 'Monday email. 7am. Nights out, not news. Updated daily. Hermosa, Manhattan, Redondo, El Segundo, Torrance.',\n  current,\n} = Astro.props;\n---\n\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"description\" content={description} />\n    <meta name=\"generator\" content={Astro.generator} />\n    <title>{title}</title>\n    <Analytics />\n  </head>\n  <body>\n    <div class=\"page\">\n      <header class=\"chrome\">\n        <div class=\"chrome-start\">\n          <a class=\"wordmark\" href=\"/\">This Week</a>\n          <nav class=\"nav\" aria-label=\"Site\">\n            <a href=\"/\" aria-current={current === 'week' ? 'page' : undefined}>This Week</a>\n            <a href=\"/next-week\" aria-current={current === 'next' ? 'page' : undefined}>Next Week</a>\n            <a href=\"/last-week\" aria-current={current === 'last' ? 'page' : undefined}>Last Week</a>\n            <a href=\"/about\" aria-current={current === 'about' ? 'page' : undefined}>About</a>\n          </nav>\n        </div>\n        <a class=\"signup-jump\" href=\"#signup\">Monday email. 7am.</a>\n      </header>\n\n      <main class=\"main\">\n        <slot />\n      </main>\n\n      <footer class=\"foot\">\n        <EmailCapture id=\"signup\" />\n        <p class=\"foot-url\">\n          <a href=\"https://thisweeksouthbay.beehiiv.com\">thisweeksouthbay.beehiiv.com</a>\n        </p>\n      </footer>\n    </div>\n  </body>\n</html>\n"}, {"file": "src/lib/events.ts", "encoding": "base64", "data": ""}, {"file": "src/pages/404.astro", "data": "---\nimport Layout from '../layouts/Layout.astro';\n---\n\n<Layout title=\"Not found — This Week South Bay\" current=\"week\">\n  <article class=\"spare\">\n    <h1>Not on the list.</h1>\n    <p><a href=\"/\">This Week</a></p>\n  </article>\n</Layout>\n"}, {"file": "src/pages/about.astro", "data": "---\nimport Layout from '../layouts/Layout.astro';\n---\n\n<Layout title=\"About — This Week South Bay\" current=\"about\">\n  <article class=\"spare\">\n    <h1>About</h1>\n    <p>\n      Residents of Hermosa, Manhattan, Redondo, El Segundo, Torrance. Palos Verdes\n      only if it is worth the drive.\n    </p>\n    <p>Not news. Not tourism. Not city council, crime, real estate, or restaurant reviews.</p>\n    <p>Monday email. 7am. Nights out, not news. Updated daily.</p>\n    <p>\n      <a href=\"https://thisweeksouthbay.beehiiv.com\">thisweeksouthbay.beehiiv.com</a>\n    </p>\n  </article>\n</Layout>\n"}, {"file": "src/pages/event/[slug].astro", "data": "---\nimport Layout from '../../layouts/Layout.astro';\nimport { allSlugs, formatWhen, getEvent, mapsUrl } from '../../lib/events';\n\nexport function getStaticPaths() {\n  return allSlugs().map((slug) => ({ params: { slug } }));\n}\n\nconst { slug } = Astro.params;\nconst event = getEvent(slug);\n\nif (!event) {\n  throw new Error(`Unknown event: ${slug}`);\n}\n\nconst when = formatWhen(event);\nconst maps = mapsUrl(event.address);\n---\n\n<Layout title={`${event.title} — This Week South Bay`} current=\"event\" description={event.blurb}>\n  <article class=\"detail\">\n    <h1>{event.title}</h1>\n    <dl>\n      <dt>When</dt>\n      <dd>\n        <time datetime={event.start}>{when}</time>\n      </dd>\n      <dt>Where</dt>\n      <dd>\n        {event.city}<br />\n        {event.venue}<br />\n        {event.address}\n      </dd>\n      {\n        event.cost ? (\n          <>\n            <dt>Cost</dt>\n            <dd>{event.cost}</dd>\n          </>\n        ) : null\n      }\n    </dl>\n    <p class=\"blurb\">{event.blurb}</p>\n    {\n      event.url ? (\n        <a class=\"source\" href={event.url}>\n          {event.url}\n        </a>\n      ) : null\n    }\n    <a class=\"maps\" href={maps}>Map</a>\n  </article>\n</Layout>\n"}, {"file": "src/pages/index.astro", "data": "---\nimport Layout from '../layouts/Layout.astro';\nimport EventRow from '../components/EventRow.astro';\nimport { catalog, groupByWeekday, weekEvents } from '../lib/events';\n\nconst days = groupByWeekday(weekEvents());\n---\n\n<Layout title=\"This Week South Bay\" current=\"week\">\n  <header class=\"masthead\">\n    <p class=\"kicker\">This Week</p>\n    <p class=\"cities\">\n      Hermosa · MB · Redondo<br />\n      El Segundo · Torrance\n    </p>\n    <p class=\"issue\">{catalog.issue.label}</p>\n    <p class=\"line\">Monday email. 7am. Nights out, not news. Updated daily.</p>\n  </header>\n\n  {\n    days.map((day) => (\n      <section class=\"day\">\n        <h2 class=\"day-label\">{day.label}</h2>\n        <ol class=\"list\">\n          {day.events.map((event) => (\n            <EventRow event={event} />\n          ))}\n        </ol>\n      </section>\n    ))\n  }\n</Layout>\n"}, {"file": "src/pages/last-week.astro", "data": "---\nimport Layout from '../layouts/Layout.astro';\n---\n\n<Layout title=\"Last Week — This Week South Bay\" current=\"last\">\n  <article class=\"spare\">\n    <h1>Last Week</h1>\n    <p>Recap is not filed yet.</p>\n  </article>\n</Layout>\n"}, {"file": "src/pages/next-week.astro", "data": "---\nimport Layout from '../layouts/Layout.astro';\nimport EventRow from '../components/EventRow.astro';\nimport { catalog, groupByWeekday, weekEvents } from '../lib/events';\n\nconst days = groupByWeekday(weekEvents(catalog.nextIssue));\n---\n\n<Layout title=\"Next Week — This Week South Bay\" current=\"next\">\n  <header class=\"masthead\">\n    <p class=\"kicker\">Next Week</p>\n    <p class=\"cities\">\n      Hermosa · MB · Redondo<br />\n      El Segundo · Torrance\n    </p>\n    <p class=\"issue\">{catalog.nextIssue.label}</p>\n    <p class=\"line\">Monday email. 7am. Nights out, not news. Updated daily.</p>\n  </header>\n\n  {\n    days.length === 0 ? (\n      <article class=\"spare\">\n        <p>Board is filling.</p>\n      </article>\n    ) : (\n      days.map((day) => (\n        <section class=\"day\">\n          <h2 class=\"day-label\">{day.label}</h2>\n          <ol class=\"list\">\n            {day.events.map((event) => (\n              <EventRow event={event} />\n            ))}\n          </ol>\n        </section>\n      ))\n    )\n  }\n</Layout>\n"}, {"file": "src/styles/global.css", "encoding": "base64", "data": ""}, {"file": "tsconfig.json", "data": "{\n  \"extends\": \"astro/tsconfigs/strict\",\n  \"include\": [\".astro/types.d.ts\", \"**/*\"],\n  \"exclude\": [\"dist\"],\n  \"compilerOptions\": {\n    \"resolveJsonModule\": true\n  }\n}\n"}]}